digraph G {
    edge [fontname="Helvetica",fontsize=10,labelfontname="arial",labelfontsize=7,color="red"];
    node [fontname="Helvetica",fontsize=10,shape=record,style=filled,fillcolor="white",color="red"];

    graph [ rankdir=BT ]
    node [ shape=none ]
 

    User [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> # userID : Integer  <br align="left"/> # userName : String  <br align="left"/> # userFirstName : String  <br align="left"/> # userLastName : String  <br align="left"/> # password : String  <br align="left"/> # userGroup : String  <br align="left"/> # post : String  <br align="left"/> # securityProblem : String  <br align="left"/> # securityAnswer : String  <br align="left"/> # birthday : String  <br align="left"/> # gender : String  <br align="left"/> # country : String  <br align="left"/> # DLNumber : String  <br align="left"/> # phone : String  <br align="left"/> # email : String  <br align="left"/> # address : String  <br align="left"/> # about : String  <br align="left"/> # regTime : String  <br align="left"/> # avatar : Image <br align="left"/></td></tr>
            <tr><td align="left"> + User() <br align="left"/> + User() <br align="left"/> + User() <br align="left"/> - initUser() <br align="left"/> + getUserID() <br align="left"/> + setUserID() <br align="left"/> + getUserName() <br align="left"/> + setUserName() <br align="left"/> + getUserFirstName() <br align="left"/> + setUserFirstName() <br align="left"/> + getUserLastName() <br align="left"/> + setUserLastName() <br align="left"/> + getPassword() <br align="left"/> + setPassword() <br align="left"/> + getUserGroup() <br align="left"/> + setUserGroup() <br align="left"/> + getPost() <br align="left"/> + setPost() <br align="left"/> + getSecurityProblem() <br align="left"/> + setSecurityProblem() <br align="left"/> + getSecurityAnswer() <br align="left"/> + setSecurityAnswer() <br align="left"/> + getBirthday() <br align="left"/> + setBirthday() <br align="left"/> + getGender() <br align="left"/> + setGender() <br align="left"/> + getCountry() <br align="left"/> + setCountry() <br align="left"/> + getDLNumber() <br align="left"/> + setDLNumber() <br align="left"/> + getPhone() <br align="left"/> + setPhone() <br align="left"/> + getEmail() <br align="left"/> + setEmail() <br align="left"/> + getAddress() <br align="left"/> + setAddress() <br align="left"/> + getAbout() <br align="left"/> + setAbout() <br align="left"/> + getRegTime() <br align="left"/> + setRegTime() <br align="left"/> + getAvatar() <br align="left"/> + setAvatar() <br align="left"/> + toString() <br align="left"/> + updateUserInfo() <br align="left"/> + updateSecurityProblem() <br align="left"/></td></tr>
        </table>> ]
    Admin [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"></td></tr>
            <tr><td align="left"> + Admin() <br align="left"/></td></tr>
        </table>> ]
    UserFactory [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"></td></tr>
            <tr><td align="left"><u> + getUser() </u><br align="left"/><u> + getUser() </u><br align="left"/></td></tr>
        </table>> ]
    Driver [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"></td></tr>
            <tr><td align="left"> + Driver() <br align="left"/></td></tr>
        </table>> ]
    Customer [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> - orderNum : Integer  <br align="left"/> - bankCardList : String  <br align="left"/> - bankCardData : ArrayListString  <br align="left"/> - vipBadge : Image  <br align="left"/> - vipCard : Image <br align="left"/></td></tr>
            <tr><td align="left"> + Customer() <br align="left"/> + Customer() <br align="left"/> + Customer() <br align="left"/> - initCustomerData() <br align="left"/> + getOrderNum() <br align="left"/> + setOrderNum() <br align="left"/> + getAvatar() <br align="left"/> + setAvatar() <br align="left"/> + getVipBadge() <br align="left"/> + setVipBadge() <br align="left"/> + getVipCard() <br align="left"/> + setVipCard() <br align="left"/> + storeCustomerInfo() <br align="left"/> + getBankCardData() <br align="left"/> + setBankCardData() <br align="left"/></td></tr>
        </table>> ]
    Car [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> - carID : Integer  <br align="left"/> - carModel : String  <br align="left"/> - chassisNumber : String  <br align="left"/> - carNumber : String  <br align="left"/> - manufacturingDate : Date  <br align="left"/> - addedDate : Date  <br align="left"/> - status : Integer <br align="left"/></td></tr>
            <tr><td align="left"> + Car() <br align="left"/> + Car() <br align="left"/> + Car() <br align="left"/> + Car() <br align="left"/> - initData() <br align="left"/> + setCarModel() <br align="left"/> + setChassisNumber() <br align="left"/> + setCarNumber() <br align="left"/> + setManufacturingDate() <br align="left"/> + setAddedDate() <br align="left"/> + setStatus() <br align="left"/> + getCarID() <br align="left"/> + getCarModel() <br align="left"/> + getChassisNumber() <br align="left"/> + getCarNumber() <br align="left"/> + getManufacturingDate() <br align="left"/> + getAddedDate() <br align="left"/> + getStatus() <br align="left"/> + updateCarInfo() <br align="left"/> + addCarInfo() <br align="left"/> + update() <br align="left"/> + delete() <br align="left"/></td></tr>
        </table>> ]
    NewCar [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> - carModel : String  <br align="left"/> - chassisNumber : String  <br align="left"/> - carNumber : String  <br align="left"/> - manufacturingDate : String  <br align="left"/> - price : String  <br align="left"/> - seatNumber : String  <br align="left"/> - gearType : String  <br align="left"/> - carBrand : String  <br align="left"/> - gradientDark : String  <br align="left"/> - gradientLight : String  <br align="left"/> - imageUrl : String  <br align="left"/> - newCarImage : Image <br align="left"/></td></tr>
            <tr><td align="left"> + NewCar() <br align="left"/> + getCarModel() <br align="left"/> + setCarModel() <br align="left"/> + getChassisNumber() <br align="left"/> + setChassisNumber() <br align="left"/> + getCarNumber() <br align="left"/> + setCarNumber() <br align="left"/> + getManufacturingDate() <br align="left"/> + setManufacturingDate() <br align="left"/> + getPrice() <br align="left"/> + setPrice() <br align="left"/> + getSeatNumber() <br align="left"/> + setSeatNumber() <br align="left"/> + getGearType() <br align="left"/> + setGearType() <br align="left"/> + getCarBrand() <br align="left"/> + setCarBrand() <br align="left"/> + getGradientDark() <br align="left"/> + setGradientDark() <br align="left"/> + getGradientLight() <br align="left"/> + setGradientLight() <br align="left"/> + getImageUrl() <br align="left"/> + setImageUrl() <br align="left"/> + getNewCarImage() <br align="left"/> + setNewCarImage() <br align="left"/> + clearProperty() <br align="left"/> + checkAllNull() <br align="left"/></td></tr>
        </table>> ]
    CarModel [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> - modelID : Integer  <br align="left"/> - carModel : String  <br align="left"/> - seats : Integer  <br align="left"/> - price : Integer  <br align="left"/> - gearType : String  <br align="left"/> - darkColor : String  <br align="left"/> - lightColor : String  <br align="left"/> - carBrand : String  <br align="left"/> - star : Real  <br align="left"/> - speed : Integer  <br align="left"/> - power : Real  <br align="left"/> - imageURL : String <br align="left"/></td></tr>
            <tr><td align="left"> + CarModel() <br align="left"/> + CarModel() <br align="left"/> + CarModel() <br align="left"/> + CarModel() <br align="left"/> - initData() <br align="left"/> + getModelID() <br align="left"/> + setModelID() <br align="left"/> + getCarModel() <br align="left"/> + setCarModel() <br align="left"/> + getSeats() <br align="left"/> + setSeats() <br align="left"/> + getPrice() <br align="left"/> + setPrice() <br align="left"/> + getGearType() <br align="left"/> + setGearType() <br align="left"/> + getDarkColor() <br align="left"/> + setDarkColor() <br align="left"/> + getLightColor() <br align="left"/> + setLightColor() <br align="left"/> + getCarBrand() <br align="left"/> + setCarBrand() <br align="left"/> + getStar() <br align="left"/> + setStar() <br align="left"/> + getSpeed() <br align="left"/> + setSpeed() <br align="left"/> + getPower() <br align="left"/> + setPower() <br align="left"/> + getImageURL() <br align="left"/> + setImageURL() <br align="left"/> + updateCarModel() <br align="left"/> + addCarModel() <br align="left"/> + update() <br align="left"/> + delete() <br align="left"/></td></tr>
        </table>> ]
    Order [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> - orderID : Integer  <br align="left"/> - carID : Integer  <br align="left"/> - orderTime : Date  <br align="left"/> - pickUpTime : Date  <br align="left"/> - returnTime : Date  <br align="left"/> - pickUpLocation : String  <br align="left"/> - parkingLocation : String  <br align="left"/> - userID : Integer  <br align="left"/> - price : Integer  <br align="left"/> - paymentMethod : String  <br align="left"/> - account : String  <br align="left"/> - status : Integer  <br align="left"/> - star : Integer  <br align="left"/> - invoiceNo : String <br align="left"/></td></tr>
            <tr><td align="left"> + Order() <br align="left"/> + Order() <br align="left"/> - initOrder() <br align="left"/> + getOrderID() <br align="left"/> + getCarID() <br align="left"/> + getOrderTime() <br align="left"/> + getOrderTimeStr() <br align="left"/> + getPickUpTime() <br align="left"/> + getPickUpTimeStr() <br align="left"/> + getReturnTime() <br align="left"/> + getReturnTimeStr() <br align="left"/> + getUserID() <br align="left"/> + getPrice() <br align="left"/> + getPaymentMethod() <br align="left"/> + getAccount() <br align="left"/> + getStatus() <br align="left"/> + getStar() <br align="left"/> + getInvoiceNo() <br align="left"/> + setOrderID() <br align="left"/> + setCarID() <br align="left"/> + setOrderTime() <br align="left"/> + setPickUpTime() <br align="left"/> + setReturnTime() <br align="left"/> + setUserID() <br align="left"/> + setPrice() <br align="left"/> + setPaymentMethod() <br align="left"/> + setAccount() <br align="left"/> + setStatus() <br align="left"/> + setStar() <br align="left"/> + setInvoiceNo() <br align="left"/> + toString() <br align="left"/></td></tr>
        </table>> ]
    Comment [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> - commentID : Integer  <br align="left"/> - type : String  <br align="left"/> - payload : String  <br align="left"/> - posterID : Integer  <br align="left"/> - comment : String  <br align="left"/> - relevantCommentID : Integer  <br align="left"/> - commentDateTime : String  <br align="left"/> - like : Integer  <br align="left"/> - star : Integer <br align="left"/></td></tr>
            <tr><td align="left"> + Comment() <br align="left"/></td></tr>
        </table>> ]
    Card [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>+\N</b></td></tr>
            <tr><td align="left"> - userID : Integer  <br align="left"/> - cardType : String  <br align="left"/> - cardName : String  <br align="left"/> - cardBankName : String  <br align="left"/> - cardHolderName : String  <br align="left"/> - cardValidDate : String  <br align="left"/> - cardNumber : String  <br align="left"/> - cardBillingAddress : String  <br align="left"/> - cardBalance : String  <br align="left"/> - cardTheme : String <br align="left"/></td></tr>
            <tr><td align="left"> + Card() <br align="left"/> + Card() <br align="left"/> + getCardDetails() <br align="left"/> + getUserID() <br align="left"/> + setUserID() <br align="left"/> + getCardType() <br align="left"/> + setCardType() <br align="left"/> + getCardName() <br align="left"/> + setCardName() <br align="left"/> + getCardBankName() <br align="left"/> + setCardBankName() <br align="left"/> + getCardHolderName() <br align="left"/> + setCardHolderName() <br align="left"/> + getCardValidDate() <br align="left"/> + setCardValidDate() <br align="left"/> + getCardNumber() <br align="left"/> + setCardNumber() <br align="left"/> + getCardBillingAddress() <br align="left"/> + setCardBillingAddress() <br align="left"/> + getCardTheme() <br align="left"/> + setCardTheme() <br align="left"/> + getCardBalance() <br align="left"/> + setCardBalance() <br align="left"/> + update() <br align="left"/> + delete() <br align="left"/></td></tr>
        </table>> ]

    Admin -> User [headlabel="", taillabel="", label="", arrowhead="empty", arrowtail="empty", style="", fontname="Helvetica", fontcolor="black", fontsize=10.0, color="red"];
    Driver -> User [headlabel="", taillabel="", label="", arrowhead="empty", arrowtail="empty", style="", fontname="Helvetica", fontcolor="black", fontsize=10.0, color="red"];
    Customer -> User [headlabel="", taillabel="", label="", arrowhead="empty", arrowtail="empty", style="", fontname="Helvetica", fontcolor="black", fontsize=10.0, color="red"];
    UserFactory -> User [headlabel="    ", taillabel="", label="", arrowhead="vee", arrowtail="empty", style="dashed", fontname="Helvetica", fontcolor="black", fontsize=10.0, color="red"];
}