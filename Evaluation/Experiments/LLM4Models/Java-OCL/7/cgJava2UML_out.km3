class NumberChecker {
   operation calculateDigitProduct( num : int) : int
  pre: true
  post: true
  activity: (     var digitSum : int ; digitSum := 0 ;
     while (num > 0) do (     digitSum := digitSum+(num mod 10) ; 
     num := num/(10) ) ; 
    var reversedSum : int ; reversedSum := 0 ;
    var temp : int ; temp := digitSum ;
    while (temp > 0) do (     reversedSum := reversedSum * 10 + temp mod 10 ; 
     temp := temp/(10) ) ; 
    return digitSum * reversedSum 
 );

   operation checkNumber() : void
  pre: true
  post: true
  activity: (     var number : int ; number := 1729 ;
     var result : int ; result := calculateDigitProduct(number) ;
     if (number = result) then (     OclFile["System.out"].println("Yes") ) else (     OclFile["System.out"].println("No") ) );

  static   operation main( args : Sequence(String)) : void
  pre: true
  post: true
  activity: (     var checker : NumberChecker ; checker := NumberChecker.newNumberChecker() ;
     checker.checkNumber() );

}

 <EOF>
