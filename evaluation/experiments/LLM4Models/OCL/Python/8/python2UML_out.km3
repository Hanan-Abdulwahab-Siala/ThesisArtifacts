
 class FromPython {


  operation initialise()
  pre: true post: true
  activity:     skip;

  operation calculate_product(value1 : int) : OclAny
  pre: true post: true
  activity:
    if value1->oclIsUndefined() then value1 := 10 else skip;
    var multiplier : int := 100 ;
    var result_value : int := value1 ;
    return multiplier * result_value;


}

