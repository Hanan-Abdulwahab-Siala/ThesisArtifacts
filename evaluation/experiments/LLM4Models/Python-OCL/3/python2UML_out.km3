
 class FromPython {




  operation initialise()
  pre: true post: true
  activity:     skip ;
    multiply_numbers(20, 2);

  operation multiply_numbers(num1 : OclAny, num2 : OclAny)
  pre: true post: true
  activity:
    var result : double := num1 * num2 ;
    execute ("Multiplication result:")->display();


}

