 class CompositeNumberChecker {
  static   operation isComposite( number : int) : boolean
  pre: true
  post: true
  activity: (     if (number <= 3) then (     OclFile["System.out"].println("False") ; 
     return false ) else skip ; 
     if (number mod 2 = 0 or number mod 3 = 0) then (     OclFile["System.out"].println("True") ; 
     return true ) else skip ; 
        var i : int ; i := 5 ; while i * i <= number do ( (     if (number mod i = 0 or number mod (i + 2) = 0) then (     OclFile["System.out"].println("True") ; 
     return true ) else skip )  ;     i := i + 6 ) ; 
    OclFile["System.out"].println("False") ; 
    return false 
 );

  static   operation main( args : Sequence(String)) : void
  pre: true
  post: true
  activity: (     var num : int ; num := 10 ;
     execute isComposite(num) );

}


