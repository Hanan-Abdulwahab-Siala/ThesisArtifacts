digraph G {
    edge [fontname="Helvetica",fontsize=10,labelfontname="arial",labelfontsize=7,color="red"];
    node [fontname="Helvetica",fontsize=10,shape=record,style=filled,fillcolor="white",color="red"];

    graph [ rankdir=BT ]
    node [ shape=none ]
 

    Player [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>\N</b></td></tr>
            <tr><td align="left"> # _player_position : unknown  <br align="left"/> # _start_pos : OclAny=null  <br align="left"/> # _end_pos : OclAny=null  <br align="left"/> # _current_pos : Sequence  <br align="left"/> # _status : Boolean=false  <br align="left"/> # _token_p_step_count : Integer=-1  <br align="left"/> # _token_q_step_count : Integer=-1  <br align="left"/> # _token_stacked : Boolean=false  <br align="left"/> # _home_square : Sequence <br align="left"/></td></tr>
            <tr><td align="left"> __init__() <br align="left"/> + get_player_position() <br align="left"/> + get_completed() <br align="left"/> + get_token_p_step_count() <br align="left"/> + get_token_q_step_count() <br align="left"/> + get_home_square() <br align="left"/> + get_space_name() <br align="left"/> + set_start_pos() <br align="left"/> + set_end_pos() <br align="left"/> + get_current_pos() <br align="left"/> + update_token_p_step_count() <br align="left"/> + update_token_q_step_count() <br align="left"/> + set_token_stacked() <br align="left"/> + get_token_stacked() <br align="left"/></td></tr>
        </table>> ]
    LudoGame [ label=<        
        <table border="0" cellborder="1" cellspacing="0">
            <tr><td><b>\N</b></td></tr>
            <tr><td align="left"> + _player_list : Sequence  <br align="left"/> + _turns_list : Sequence <br align="left"/></td></tr>
            <tr><td align="left"> __init__() <br align="left"/> + update_player_list() <br align="left"/> + get_player_list() <br align="left"/> + get_player_by_position() <br align="left"/> + move_token_p() <br align="left"/> + move_token_q() <br align="left"/> + play_game() <br align="left"/> + get_all_player_spaces() <br align="left"/> + initialize_players() <br align="left"/> + play_one_round() <br align="left"/> + get_all_opponent_spaces() <br align="left"/></td></tr>
        </table>> ]

}