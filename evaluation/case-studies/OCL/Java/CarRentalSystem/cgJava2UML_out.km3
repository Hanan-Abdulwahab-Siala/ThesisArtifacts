   attribute vipCard : Image;

   static operation newCustomer() : Customer
  pre: true
  post: true
  activity:
  ( var self : Customer ;
    self := createCustomer();
    self.initialise();
    return self );

  operation initialise() : void
  pre: true  post: true
  activity: (     execute super() );


   static operation newCustomer( email : String) : Customer
  pre: true
  post: true
  activity:
  ( var self : Customer ;
    self := createCustomer();
    self.initialise(email);
    return self );

  operation initialise( email : String) : void
  pre: true  post: true
  activity: (     execute super(email) ; 
     execute initCustomerData() );


   operation initCustomerData() : void
  pre: true
  post: true
  activity: (     self.orderNum := DataTools.getCustomerOrderNum(userID) ; 
     self.bankCardList := DataTools.getCustomerBankCardsList(userID) ; 
    self.bankCardData := DataTools.getCustomerBankCardsData(userID) ; 
    self.vipBadge := ImageTools.getBadgeImage(userID) ; 
    self.vipCard := ImageTools.getVIPCardImage(userID) ; 
 );

   static operation newCustomer( userFirstName : String, userLastName : String, password : String, userGroup : String, post : String, securityProblem : String, securityAnswer : String, birthday : String, gender : String, country : String, DLNumber : String, phone : String, email : String, address : String, about : String, regTime : String) : Customer
  pre: true
  post: true
  activity:
  ( var self : Customer ;
    self := createCustomer();
    self.initialise(userFirstName, userLastName,password,userGroup,post,securityProblem,securityAnswer,birthday,gender,country,DLNumber,phone,email,address,about,regTime);
    return self );

  operation initialise( userFirstName : String, userLastName : String, password : String, userGroup : String, post : String, securityProblem : String, securityAnswer : String, birthday : String, gender : String, country : String, DLNumber : String, phone : String, email : String, address : String, about : String, regTime : String) : void
  pre: true  post: true
  activity: (     execute super(userFirstName, userLastName, password, userGroup, post, securityProblem, securityAnswer, birthday, gender, country, DLNumber, phone, email, address, about, regTime) );


   operation getOrderNum() : int
  pre: true
  post: true
  activity: (     return orderNum );

   operation setOrderNum( orderNum : int) : void
  pre: true
  post: true
  activity: (     self.orderNum := orderNum );

   operation getAvatar() : Image
  pre: true
  post: true
  activity: (     return avatar );

   operation setAvatar( avatar : Image) : void
  pre: true
  post: true
  activity: (     self.avatar := avatar );

   operation getVipBadge() : Image
  pre: true
  post: true
  activity: (     return vipBadge );

   operation setVipBadge( vipBadge : Image) : void
  pre: true
  post: true
  activity: (     self.vipBadge := vipBadge );

   operation getVipCard() : Image
  pre: true
  post: true
  activity: (     return vipCard );

   operation setVipCard( vipCard : Image) : void
  pre: true
  post: true
  activity: (     self.vipCard := vipCard );

   operation storeCustomerInfo() : boolean
  pre: true
  post: true
  activity: (     var userID : String ; userID := ((DataTools.getNewUserID()) + "") ;
     var userinfo : Sequence(String) ; userinfo := Sequence{userID,userFirstName + "-" + userLastName,userGroup,post,securityProblem,securityAnswer,birthday,gender,country,DLNumber,phone,email,address,about,regTime} ;
    var userAndPassword : String ; userAndPassword := userID + "," + password ;
    var userinfoStr : String ; userinfoStr := join(",", userinfo) ;
    try (     FileOperate.addStringToFile(ConfigFile.dataFilesRootPath + "userinfo.txt", userinfoStr) ; 
     FileOperate.addStringToFile(ConfigFile.dataFilesRootPath + "password.txt", userAndPassword) ; 
     ImageTools.addDefaultAvatar((userID)->toInteger()) ; 
     return true )   catch (e : ProgramException) do (     e.printStackTrace() ; 
     return false )
 
 );

   operation getBankCardData() : Sequence(Sequence(String))
  pre: true
  post: true
  activity: (     return bankCardData );

   operation setBankCardData( bankCardData : Sequence(Sequence(String))) : void
  pre: true
  post: true
  activity: (     self.bankCardData := bankCardData );

}

class Car {
   attribute carID : int;

   attribute carModel : String;

   attribute chassisNumber : String;

   attribute carNumber : String;

   attribute carBrand : String;

   attribute manufacturingDate : OclDate;

   attribute addedDate : OclDate;

   attribute status : int;

   static operation newCar( carID : int) : Car
  pre: true
  post: true
  activity:
  ( var self : Car ;
    self := createCar();
    self.initialise(carID);
    return self );

  operation initialise( carID : int) : void
  pre: true  post: true
  activity: (     self.carID := carID ; 
     execute initData() );


   operation initData() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "SELECT * FROM carInfo WHERE carID = " + carID ;
     var data : Sequence(Sequence(String)) ; data := SQL.query(sql) ;
    if (data->size() = 0) then (     return ) else skip ; 
    var carInfo : Sequence(String) ; carInfo := data->at(0+1) ;
    carModel := carInfo[1+1] ; 
    chassisNumber := carInfo[2+1] ; 
    carNumber := carInfo[3+1] ; 
    manufacturingDate := DateTools.stringToDateObje(carInfo[4+1]) ; 
    OclFile["System.out"].println("manufacturingDate: " + manufacturingDate) ; 
    addedDate := DateTools.stringToDateObje(carInfo[5+1]) ; 
    status := (carInfo[6+1])->toInteger() ; 
 );

   static operation newCar( carID : int, carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : OclDate, status : int) : Car
  pre: true
  post: true
  activity:
  ( var self : Car ;
    self := createCar();
    self.initialise(carID, carModel,chassisNumber,carNumber,manufacturingDate,status);
    return self );

  operation initialise( carID : int, carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : OclDate, status : int) : void
  pre: true  post: true
  activity: (     self.carID := carID ; 
     self.carModel := carModel ; 
    self.chassisNumber := chassisNumber ; 
    self.carNumber := carNumber ; 
    self.manufacturingDate := manufacturingDate ; 
    self.status := status ; 
 );


   static operation newCar( carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : String, status : int) : Car
  pre: true
  post: true
  activity:
  ( var self : Car ;
    self := createCar();
    self.initialise(carModel, chassisNumber,carNumber,manufacturingDate,status);
    return self );

  operation initialise( carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : String, status : int) : void
  pre: true  post: true
  activity: (     self.carModel := carModel ; 
     self.chassisNumber := chassisNumber ; 
    self.carNumber := carNumber ; 
    self.manufacturingDate := DateTools.stringToDateObje(manufacturingDate) ; 
    self.status := status ; 
 );


   static operation newCar( carID : int, carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : OclDate, addedDate : OclDate, status : int) : Car
  pre: true
  post: true
  activity:
  ( var self : Car ;
    self := createCar();
    self.initialise(carID, carModel,chassisNumber,carNumber,manufacturingDate,addedDate,status);
    return self );

  operation initialise( carID : int, carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : OclDate, addedDate : OclDate, status : int) : void
  pre: true  post: true
  activity: (     self.carID := carID ; 
     self.carModel := carModel ; 
    self.chassisNumber := chassisNumber ; 
    self.carNumber := carNumber ; 
    self.manufacturingDate := manufacturingDate ; 
    self.addedDate := addedDate ; 
    self.status := status ; 
 );


   operation setCarModel( carModel : String) : void
  pre: true
  post: true
  activity: (     self.carModel := carModel );

   operation setChassisNumber( chassisNumber : String) : void
  pre: true
  post: true
  activity: (     self.chassisNumber := chassisNumber );

   operation setCarNumber( carNumber : String) : void
  pre: true
  post: true
  activity: (     self.carNumber := carNumber );

   operation setManufacturingDate( manufacturingDate : OclDate) : void
  pre: true
  post: true
  activity: (     self.manufacturingDate := manufacturingDate );

   operation setAddedDate( addedDate : OclDate) : void
  pre: true
  post: true
  activity: (     self.addedDate := addedDate );

   operation setStatus( status : int) : void
  pre: true
  post: true
  activity: (     self.status := status );

   operation getCarID() : int
  pre: true
  post: true
  activity: (     return carID );

   operation getCarModel() : String
  pre: true
  post: true
  activity: (     return carModel );

   operation getChassisNumber() : String
  pre: true
  post: true
  activity: (     return chassisNumber );

   operation getCarNumber() : String
  pre: true
  post: true
  activity: (     return carNumber );

   operation getManufacturingDate() : String
  pre: true
  post: true
  activity: (     OclFile["System.out"].println("Date: " + manufacturingDate) ; 
     return DateTools.dateToString(manufacturingDate, "yyyy-MM-dd") );

   operation getAddedDate() : String
  pre: true
  post: true
  activity: (     return DateTools.dateToString(addedDate, "yyyy-MM-dd") );

   operation getStatus() : int
  pre: true
  post: true
  activity: (     return status );

   operation updateCarInfo( carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : String, status : int) : void
  pre: true
  post: true
  activity: (     self.carModel := carModel ; 
     self.chassisNumber := chassisNumber ; 
    self.carNumber := carNumber ; 
    self.manufacturingDate := DateTools.stringToDateObje(manufacturingDate) ; 
    self.status := status ; 
    execute update() ; 
 );

   operation addCarInfo() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "INSERT INTO carInfo VALUES (" + (DataTools.getID("carModels") - 1) + ", '" + carModel + "', '" + chassisNumber + "', '" + carNumber + "', '" + DateTools.dateToString(manufacturingDate, "yyyy-MM-dd") + "', '" + DateTools.getNow() + "', " + status + ")" ;
     OclFile["System.out"].println(sql) ; 
     SQL.execute(sql) );

   operation update() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "UPDATE carInfo SET carModel = '" + carModel + "', chassisNumber = '" + chassisNumber + "', carNumber = '" + carNumber + "', manufacturingDate = '" + DateTools.dateToString(manufacturingDate, "yyyy-MM-dd") + "', status = " + status + " WHERE carID = " + carID ;
     SQL.execute(sql) );

   operation delete() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "DELETE FROM carInfo WHERE carID = " + carID ;
     SQL.execute(sql) ; 
     OclFile["System.out"].println("done") );

}

class NewCar {
   attribute carModel : String;

   attribute chassisNumber : String;

   attribute carNumber : String;

   attribute manufacturingDate : String;

   attribute price : String;

   attribute seatNumber : String;

   attribute gearType : String;

   attribute carBrand : String;

   attribute gradientDark : String;

   attribute gradientLight : String;

   attribute imageUrl : String;

   attribute newCarImage : Image;

   static operation newNewCar( carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : String, price : String, seatNumber : String, gearType : String, carBrand : String, gradientDark : String, gradientLight : String, imageUrl : String, newCarImage : Image) : NewCar
  pre: true
  post: true
  activity:
  ( var self : NewCar ;
    self := createNewCar();
    self.initialise(carModel, chassisNumber,carNumber,manufacturingDate,price,seatNumber,gearType,carBrand,gradientDark,gradientLight,imageUrl,newCarImage);
    return self );

  operation initialise( carModel : String, chassisNumber : String, carNumber : String, manufacturingDate : String, price : String, seatNumber : String, gearType : String, carBrand : String, gradientDark : String, gradientLight : String, imageUrl : String, newCarImage : Image) : void
  pre: true  post: true
  activity: (     self.carModel := carModel ; 
     self.chassisNumber := chassisNumber ; 
    self.carNumber := carNumber ; 
    self.manufacturingDate := manufacturingDate ; 
    self.price := price ; 
    self.seatNumber := seatNumber ; 
    self.gearType := gearType ; 
    self.carBrand := carBrand ; 
    self.gradientDark := gradientDark ; 
    self.gradientLight := gradientLight ; 
    self.imageUrl := imageUrl ; 
    self.newCarImage := newCarImage ; 
 );


   operation getCarModel() : String
  pre: true
  post: true
  activity: (     return carModel );

   operation setCarModel( carModel : String) : void
  pre: true
  post: true
  activity: (     self.carModel := carModel );

   operation getChassisNumber() : String
  pre: true
  post: true
  activity: (     return chassisNumber );

   operation setChassisNumber( chassisNumber : String) : void
  pre: true
  post: true
  activity: (     self.chassisNumber := chassisNumber );

   operation getCarNumber() : String
  pre: true
  post: true
  activity: (     return carNumber );

   operation setCarNumber( carNumber : String) : void
  pre: true
  post: true
  activity: (     self.carNumber := carNumber );

   operation getManufacturingDate() : String
  pre: true
  post: true
  activity: (     return manufacturingDate );

   operation setManufacturingDate( manufacturingDate : String) : void
  pre: true
  post: true
  activity: (     self.manufacturingDate := manufacturingDate );

   operation getPrice() : String
  pre: true
