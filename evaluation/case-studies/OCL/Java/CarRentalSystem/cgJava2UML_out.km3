   operation getReturnTime() : OclDate
  pre: true
  post: true
  activity: (     return returnTime );

   operation getReturnTimeStr() : String
  pre: true
  post: true
  activity: (     return DateTools.getSpecFormatDateTime(returnTime) );

   operation getUserID() : int
  pre: true
  post: true
  activity: (     return userID );

   operation getPrice() : int
  pre: true
  post: true
  activity: (     return price );

   operation getPaymentMethod() : String
  pre: true
  post: true
  activity: (     return paymentMethod );

   operation getAccount() : String
  pre: true
  post: true
  activity: (     return account );

   operation getStatus() : int
  pre: true
  post: true
  activity: (     return status );

   operation getStar() : int
  pre: true
  post: true
  activity: (     return star );

   operation setOrderID( orderID : int) : void
  pre: true
  post: true
  activity: (     self.orderID := orderID );

   operation setCarID( carID : int) : void
  pre: true
  post: true
  activity: (     self.carID := carID );

   operation setOrderTime( orderTime : OclDate) : void
  pre: true
  post: true
  activity: (     self.orderTime := orderTime );

   operation setPickUpTime( pickUpTime : OclDate) : void
  pre: true
  post: true
  activity: (     self.pickUpTime := pickUpTime );

   operation setReturnTime( returnTime : OclDate) : void
  pre: true
  post: true
  activity: (     self.returnTime := returnTime );

   operation setUserID( userID : int) : void
  pre: true
  post: true
  activity: (     self.userID := userID );

   operation setPrice( price : int) : void
  pre: true
  post: true
  activity: (     self.price := price );

   operation setPaymentMethod( paymentMethod : String) : void
  pre: true
  post: true
  activity: (     self.paymentMethod := paymentMethod );

   operation setAccount( account : String) : void
  pre: true
  post: true
  activity: (     self.account := account );

   operation setStatus( status : int) : void
  pre: true
  post: true
  activity: (     self.status := status );

   operation setStar( star : int) : void
  pre: true
  post: true
  activity: (     self.star := star );

   operation getPickUpLocation() : String
  pre: true
  post: true
  activity: (     return pickUpLocation );

   operation setPickUpLocation( pickUpLocation : String) : void
  pre: true
  post: true
  activity: (     self.pickUpLocation := pickUpLocation );

