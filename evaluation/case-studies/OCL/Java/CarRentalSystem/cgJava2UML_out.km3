  pre: true
  post: true
  activity: (     self.invoiceNo := invoiceNo );

      operation toString() : String
  pre: true
  post: true
  activity: (     return "Order{" + "orderID=" + orderID + ", carID=" + carID + ", orderTime=" + orderTime + ", pickUpTime=" + pickUpTime + ", returnTime=" + returnTime + ", userID=" + userID + ", price=" + price + ", paymentMethod='" + paymentMethod + '\'' + ", account='" + account + '\'' + ", status=" + status + ", star=" + star + ", invoiceNo='" + invoiceNo + '\'' + '}' );

}

