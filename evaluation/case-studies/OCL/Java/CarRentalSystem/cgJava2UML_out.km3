class User {
     attribute userID : int := 0;

     attribute userName : String := "null";

     attribute userFirstName : String := "null";

     attribute userLastName : String := "null";

     attribute password : String := "0123456789";

     attribute userGroup : String := "customer";

     attribute post : String := "null";

     attribute securityProblem : String := "null";

     attribute securityAnswer : String := "null";

     attribute birthday : String := "2022-01-01 00:00:00";

     attribute gender : String := "null";

     attribute country : String := "null";

     attribute DLNumber : String := "null";

     attribute phone : String := "0123456789";

     attribute email : String := "rent@mail.com";

     attribute address : String := "null";

     attribute about : String := "null";

     attribute regTime : String := "null";

     attribute avatar : Image;

   static operation newUser() : User
  pre: true
  post: true
  activity:
  ( var self : User ;
    self := createUser();
    self.initialise();
    return self );

  operation initialise() : void
  pre: true  post: true
  activity: skip;


   static operation newUser( email : String) : User
  pre: true
  post: true
  activity:
  ( var self : User ;
    self := createUser();
    self.initialise(email);
    return self );

  operation initialise( email : String) : void
  pre: true  post: true
  activity: (     self.email := email ; 
     execute initUser() );


   static operation newUser( userFirstName : String, userLastName : String, password : String, userGroup : String, post : String, securityProblem : String, securityAnswer : String, birthday : String, gender : String, country : String, DLNumber : String, phone : String, email : String, address : String, about : String, regTime : String) : User
  pre: true
  post: true
  activity:
  ( var self : User ;
    self := createUser();
    self.initialise(userFirstName, userLastName,password,userGroup,post,securityProblem,securityAnswer,birthday,gender,country,DLNumber,phone,email,address,about,regTime);
    return self );

  operation initialise( userFirstName : String, userLastName : String, password : String, userGroup : String, post : String, securityProblem : String, securityAnswer : String, birthday : String, gender : String, country : String, DLNumber : String, phone : String, email : String, address : String, about : String, regTime : String) : void
  pre: true  post: true
  activity: (     self.userName := userFirstName + "-" + userLastName ; 
     self.password := password ; 
    self.userGroup := userGroup ; 
    self.post := post ; 
    self.securityProblem := securityProblem ; 
    self.securityAnswer := securityAnswer ; 
    self.birthday := birthday ; 
    self.gender := gender ; 
    self.country := country ; 
    self.DLNumber := DLNumber ; 
    self.phone := phone ; 
    self.email := email ; 
    self.address := address ; 
    self.about := about ; 
    self.regTime := regTime ; 
 );


   operation initUser() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "select * from userInfo where email = '" + self.email + "'" ;
     var userInfo : Sequence(Sequence(String)) ; userInfo := SQL.query(sql) ;
    if (userInfo->size() = 0) then (     error ProgramException("No user found") ) else skip ; 
    var user : Sequence(String) ; user := userInfo->at(0+1) ;
    self.userID := (user[0+1])->toInteger() ; 
    self.userName := user[1+1].replace("-", " ") ; 
    self.userGroup := user[2+1] ; 
    self.post := user[3+1] ; 
    self.securityProblem := user[4+1] ; 
    self.securityAnswer := user[5+1] ; 
    self.birthday := user[6+1] ; 
    self.gender := user[7+1] ; 
    self.country := user[8+1] ; 
    self.DLNumber := user[9+1] ; 
    self.phone := user[10+1] ; 
    self.email := user[11+1] ; 
    self.address := user[12+1] ; 
    self.about := user[13+1] ; 
    self.regTime := user[14+1] ; 
    self.avatar := ImageTools.getUserAvatarFromUserID(userID) ; 
 );

   operation getUserID() : int
  pre: true
  post: true
  activity: (     return userID );

   operation setUserID( userID : int) : void
  pre: true
  post: true
  activity: (     self.userID := userID );

   operation getUserName() : String
  pre: true
  post: true
  activity: (     return userName );

   operation setUserName( userName : String) : void
  pre: true
  post: true
  activity: (     self.userName := userName );

   operation getUserFirstName() : String
  pre: true
  post: true
  activity: (     return userFirstName );

   operation setUserFirstName( userFirstName : String) : void
  pre: true
  post: true
  activity: (     self.userFirstName := userFirstName );

   operation getUserLastName() : String
  pre: true
  post: true
  activity: (     return userLastName );

   operation setUserLastName( userLastName : String) : void
  pre: true
  post: true
  activity: (     self.userLastName := userLastName );

   operation getPassword() : String
  pre: true
  post: true
  activity: (     return password );

   operation setPassword( password : String) : void
  pre: true
  post: true
  activity: (     self.password := password );

   operation getUserGroup() : String
  pre: true
  post: true
  activity: (     return userGroup );

   operation setUserGroup( userGroup : String) : void
  pre: true
  post: true
  activity: (     self.userGroup := userGroup );

   operation getPost() : String
  pre: true
  post: true
  activity: (     return post );

   operation setPost( post : String) : void
  pre: true
  post: true
  activity: (     self.post := post );

   operation getSecurityProblem() : String
  pre: true
  post: true
  activity: (     return securityProblem );

   operation setSecurityProblem( securityProblem : String) : void
  pre: true
  post: true
  activity: (     self.securityProblem := securityProblem );

   operation getSecurityAnswer() : String
  pre: true
  post: true
  activity: (     return securityAnswer );

   operation setSecurityAnswer( securityAnswer : String) : void
  pre: true
  post: true
  activity: (     self.securityAnswer := securityAnswer );

   operation getBirthday() : String
  pre: true
  post: true
  activity: (     return birthday );

   operation setBirthday( birthday : String) : void
  pre: true
  post: true
  activity: (     self.birthday := birthday );

   operation getGender() : String
  pre: true
  post: true
  activity: (     return gender );

   operation setGender( gender : String) : void
  pre: true
  post: true
  activity: (     self.gender := gender );

   operation getCountry() : String
  pre: true
  post: true
  activity: (     return country );

   operation setCountry( country : String) : void
  pre: true
  post: true
  activity: (     self.country := country );

   operation getDLNumber() : String
  pre: true
  post: true
  activity: (     return DLNumber );

   operation setDLNumber( DLNumber : String) : void
  pre: true
  post: true
  activity: (     self.DLNumber := DLNumber );

   operation getPhone() : String
  pre: true
  post: true
  activity: (     return phone );

   operation setPhone( phone : String) : void
  pre: true
  post: true
  activity: (     self.phone := phone );

   operation getEmail() : String
  pre: true
  post: true
  activity: (     return email );

   operation setEmail( email : String) : void
  pre: true
  post: true
  activity: (     self.email := email );

   operation getAddress() : String
  pre: true
  post: true
  activity: (     return address );

   operation setAddress( address : String) : void
  pre: true
  post: true
  activity: (     self.address := address );

   operation getAbout() : String
  pre: true
  post: true
  activity: (     return about );

   operation setAbout( about : String) : void
  pre: true
  post: true
  activity: (     self.about := about );

   operation getRegTime() : String
  pre: true
  post: true
  activity: (     return regTime );

   operation setRegTime( regTime : String) : void
  pre: true
  post: true
  activity: (     self.regTime := regTime );

   operation getAvatar() : Image
  pre: true
  post: true
  activity: (     return avatar );

   operation setAvatar( avatar : Image) : void
  pre: true
  post: true
  activity: (     self.avatar := avatar );

      operation toString() : String
  pre: true
  post: true
  activity: (     return "User{" + ",\n" + "userID=" + userID + ",\n" + "userName='" + userName + '\'' + ",\n" + "userGroup='" + userGroup + '\'' + ",\n" + "post='" + post + '\'' + ",\n" + "securityProblem='" + securityProblem + '\'' + ",\n" + "securityAnswer='" + securityAnswer + '\'' + ",\n" + "birthday='" + birthday + '\'' + ",\n" + "gender='" + gender + '\'' + ",\n" + "country='" + country + '\'' + ",\n" + "DLNumber='" + DLNumber + '\'' + ",\n" + "phone='" + phone + '\'' + ",\n" + "email='" + email + '\'' + ",\n" + "address='" + address + '\'' + ",\n" + "about='" + about + '\'' + ",\n" + "regTime='" + regTime + '\'' + ",\n" + '}' );

   operation updateUserInfo() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "UPDATE userInfo SET userName = '" + userName + "', birthday = '" + birthday + "', phone = '" + phone + "', email = '" + email + "', address = '" + address + "', about = '" + about + "' WHERE userID = " + userID ;
     SQL.execute(sql) );

   operation updateSecurityProblem( newSecurityProblem : String, newSecurityAnswer : String) : void
  pre: true
  post: true
  activity: (     self.securityProblem := newSecurityProblem ; 
     self.securityAnswer := newSecurityAnswer ; 
     var sql : String ; sql := "UPDATE userInfo SET securityProblem = '" + newSecurityProblem + "', securityAnswer = '" + newSecurityAnswer + "' WHERE userID = " + userID ;
     SQL.execute(sql) );

}

