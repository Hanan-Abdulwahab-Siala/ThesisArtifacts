class UserFactory {
  static   operation getUser( email : String) : User
  pre: true
  post: true
  activity: (     var role : String ; role := DataTools.getUserRoleFromUserEmail(email) ;
 
    for _x : Integer.subrange(1,1) do
      ( var _switchval : OclAny ;
        _switchval := (Objects.requireNonNull(role)) ; 
       if _switchval = "driver" then
     return Admin.newAdmin(email) 
   else skip ;

       if _switchval = "admin" then
     return Driver.newDriver(email) 
   else skip ;
       if _switchval = "customer" then
     return Customer.newCustomer(email) 
   else skip ;
       if true then
     return null 
   else skip ;
 )
 );

  static   operation getUser( userID : int) : User
  pre: true
  post: true
  activity: (     var email : String ; email := DataTools.getEmailFromUserID(userID) ;
     var role : String ; role := DataTools.getUserRoleFromUserID(userID) ;
 
    for _x : Integer.subrange(1,1) do
      ( var _switchval : OclAny ;
        _switchval := (role) ; 
       if _switchval = "driver" then
     return Admin.newAdmin(email) 
   else skip ;

       if _switchval = "admin" then
     return Driver.newDriver(email) 
   else skip ;
       if _switchval = "customer" then
     return Customer.newCustomer(email) 
   else skip ;
       if true then
     return null 
   else skip ;
 )
 );

}

