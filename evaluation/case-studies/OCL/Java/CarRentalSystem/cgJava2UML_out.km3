 );

   operation checkAllNull() : boolean
  pre: true
  post: true
  activity: (     var fields : Sequence(OclAttribute) ; fields := self->oclType().getDeclaredFields() ;
     for (field : fields) do ( (     field.setAccessible(true) ; 
     if (field->at(self+1) /= null) then (     if (field.getName() = "gradientDark" or field.getName() = "gradientLight") then (     continue ) else skip ; 
     return false ) else skip )  ) ; 
     return true );

}

class CarModel {
   attribute modelID : int;

   attribute carModel : String;

   attribute seats : int;

   attribute price : int;

   attribute gearType : String;

   attribute darkColor : String;

   attribute lightColor : String;

   attribute carBrand : String;

   attribute star : double;

   attribute speed : int;

   attribute power : double;

   attribute imageURL : String;

   static operation newCarModel() : CarModel
  pre: true
  post: true
  activity:
  ( var self : CarModel ;
    self := createCarModel();
    self.initialise();
    return self );

  operation initialise() : void
  pre: true  post: true
  activity: skip;


   static operation newCarModel( modelID : int) : CarModel
  pre: true
  post: true
  activity:
  ( var self : CarModel ;
    self := createCarModel();
    self.initialise(modelID);
    return self );

  operation initialise( modelID : int) : void
  pre: true  post: true
  activity: (     self.modelID := modelID ; 
     execute initData("modelID") );


   static operation newCarModel( carModel : String) : CarModel
  pre: true
  post: true
  activity:
  ( var self : CarModel ;
    self := createCarModel();
    self.initialise(carModel);
    return self );

  operation initialise( carModel : String) : void
  pre: true  post: true
  activity: (     self.carModel := carModel ; 
     execute initData("carModel") );


   operation initData( type : String) : void
  pre: true
  post: true
  activity: (     var sql : String ;
     if (Objects = type, "modelID") then (     sql := "SELECT * FROM carModels WHERE " + type + " = " + modelID ) else     if (Objects = type, "carModel") then (     sql := "SELECT * FROM carModels WHERE " + type + " = " + "'" + carModel + "'" ) else (     error IllegalArgumentException.newIllegalArgumentException("type must be modelID or carModel") ) ;  ;  
    var data : Sequence(Sequence(String)) ; data := SQL.query(sql) ;
    if (data->size() = 0) then (     return ) else skip ; 
    var carModelInfo : Sequence(String) ; carModelInfo := data->at(0+1) ;
    modelID := (carModelInfo[0+1])->toInteger() ; 
    carModel := carModelInfo[1+1] ; 
    seats := (carModelInfo[2+1])->toInteger() ; 
    price := (carModelInfo[3+1])->toInteger() ; 
    gearType := carModelInfo[4+1] ; 
    darkColor := carModelInfo[5+1] ; 
    lightColor := carModelInfo[6+1] ; 
    carBrand := carModelInfo[7+1] ; 
    star := (carModelInfo[8+1])->toReal() ; 
    speed := (carModelInfo[9+1])->toInteger() ; 
    power := (carModelInfo[10+1])->toReal() ; 
    imageURL := "file:src/main/resources/com/example/car_rental_sys/image/cars/" + carModel + ".png" ; 
 );

   static operation newCarModel( carModel : String, seats : int, price : int, gearType : String, darkColor : String, lightColor : String, carBrand : String, imageURL : String) : CarModel
  pre: true
  post: true
  activity:
  ( var self : CarModel ;
    self := createCarModel();
    self.initialise(carModel, seats,price,gearType,darkColor,lightColor,carBrand,imageURL);
    return self );

  operation initialise( carModel : String, seats : int, price : int, gearType : String, darkColor : String, lightColor : String, carBrand : String, imageURL : String) : void
  pre: true  post: true
  activity: (     self.carModel := carModel ; 
     self.seats := seats ; 
    self.price := price ; 
    self.gearType := gearType ; 
    self.darkColor := darkColor ; 
    self.lightColor := lightColor ; 
    self.carBrand := carBrand ; 
    self.imageURL := imageURL ; 
 );


   static operation newCarModel( modelID : int, carModel : String, seats : int, price : int, gearType : String, darkColor : String, lightColor : String, carBrand : String, star : double, speed : int, power : double) : CarModel
  pre: true
  post: true
  activity:
  ( var self : CarModel ;
    self := createCarModel();
    self.initialise(modelID, carModel,seats,price,gearType,darkColor,lightColor,carBrand,star,speed,power);
    return self );

  operation initialise( modelID : int, carModel : String, seats : int, price : int, gearType : String, darkColor : String, lightColor : String, carBrand : String, star : double, speed : int, power : double) : void
  pre: true  post: true
  activity: (     self.modelID := modelID ; 
     self.carModel := carModel ; 
    self.seats := seats ; 
    self.price := price ; 
    self.gearType := gearType ; 
    self.darkColor := darkColor ; 
    self.lightColor := lightColor ; 
    self.carBrand := carBrand ; 
    self.star := star ; 
    self.speed := speed ; 
    self.power := power ; 
 );


