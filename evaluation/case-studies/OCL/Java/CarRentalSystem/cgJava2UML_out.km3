   operation updateCarModel( carModel : String, seats : int, price : int, gearType : String, darkColor : String, lightColor : String) : void
  pre: true
  post: true
  activity: (     self.carModel := carModel ; 
     self.seats := seats ; 
    self.price := price ; 
    self.gearType := gearType ; 
    self.darkColor := darkColor ; 
    self.lightColor := lightColor ; 
    execute update() ; 
 );

   operation addCarModel() : void
  pre: true
  post: true
  activity: (     var values : String ; values := DataTools.getID("carModels") + ",'" + carModel + "'," + seats + "," + price + ",'" + gearType + "','" + darkColor + "','" + lightColor + "','" + carBrand + "'," + DataTools.getCarStar() + "," + DataTools.getCarSpeed() + "," + DataTools.getCarPower() ;
     var sql : String ; sql := "INSERT INTO carModels VALUES (" + values + ")" ;
    OclFile["System.out"].println(sql) ; 
    SQL.execute(sql) ; 
    OclFile["System.out"].println(imageURL) ; 
    ImageTools.renameCarImage(imageURL, carModel) ; 
 );

   operation update() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "UPDATE carModels SET carModel = '" + carModel + "', seats = " + seats + ", price = " + price + ", gearType = '" + gearType + "', darkColor = '" + darkColor + "', lightColor = '" + lightColor + "' WHERE modelID = " + modelID ;
     OclFile["System.out"].println(sql) ; 
     var process : boolean ; process := SQL.execute(sql) ;
     OclFile["System.out"].println(process) );

   operation delete() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "DELETE FROM carModels WHERE modelID = " + modelID ;
     SQL.execute(sql) ; 
     OclFile["System.out"].println("done") ; 
     ImageTools.deleteFile(imageURL) );

}

class Order {
   attribute orderID : int;

   attribute carID : int;

   attribute orderTime : OclDate := null;

   attribute pickUpTime : OclDate := null;

   attribute returnTime : OclDate := null;

   attribute pickUpLocation : String := "";

   attribute parkingLocation : String := "";

   attribute userID : int := 0;

   attribute price : int := 0;

   attribute paymentMethod : String := "";

   attribute account : String := "";

   attribute status : int := -1;

   attribute star : int := 0;

   attribute invoiceNo : String := "";

   static operation newOrder() : Order
  pre: true
  post: true
  activity:
  ( var self : Order ;
    self := createOrder();
    self.initialise();
    return self );

  operation initialise() : void
  pre: true  post: true
  activity: skip;


   static operation newOrder( orderID : int) : Order
  pre: true
  post: true
  activity:
  ( var self : Order ;
    self := createOrder();
    self.initialise(orderID);
    return self );

  operation initialise( orderID : int) : void
  pre: true  post: true
  activity: (     self.orderID := orderID ; 
     execute initOrder() );


   operation initOrder() : void
  pre: true
  post: true
  activity: (     var sql : String ; sql := "select * from orders where orderID = " + orderID ;
     var result : Sequence(Sequence(String)) ; result := SQL.query(sql) ;
     if (result->size() = 0) then (     OclFile["System.out"].println("Order: " + self.orderID + "not found") ) else (     var orderInfo : Sequence(String) ; orderInfo := result->at(0+1) ;
     self.carID := (orderInfo[1+1])->toInteger() ; 
    self.orderTime := DateTools.stringToDateObje(orderInfo[2+1]) ; 
    self.pickUpTime := DateTools.stringToDateObje(orderInfo[3+1]) ; 
    self.returnTime := DateTools.stringToDateObje(orderInfo[4+1]) ; 
    self.pickUpLocation := orderInfo[5+1] ; 
    self.parkingLocation := orderInfo[6+1] ; 
    self.userID := (orderInfo[7+1])->toInteger() ; 
    self.price := (orderInfo[8+1])->toInteger() ; 
    self.paymentMethod := orderInfo[9+1] ; 
    self.account := orderInfo[10+1] ; 
    self.status := (orderInfo[11+1])->toInteger() ; 
    self.star := (orderInfo[12+1])->toInteger() ; 
    self.invoiceNo := DataTools.generateRandomInvoiceNo(self.orderID) ; 
 ) );

   operation getOrderID() : int
  pre: true
  post: true
  activity: (     return orderID );

   operation getCarID() : int
  pre: true
  post: true
  activity: (     return carID );

