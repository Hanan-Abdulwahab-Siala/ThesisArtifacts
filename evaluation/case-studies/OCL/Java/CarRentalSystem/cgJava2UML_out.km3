    self.cardName := cardDetails[2+1] ; 
    self.cardBankName := cardDetails[3+1] ; 
    self.cardHolderName := cardDetails[4+1] ; 
    self.cardValidDate := cardDetails[5+1] ; 
    self.cardNumber := cardDetails[6+1] ; 
    self.cardBillingAddress := cardDetails[7+1] ; 
    self.cardTheme := cardDetails[8+1]->split(",") ; 
    self.cardBalance := cardDetails[9+1] ; 
 );


